SERVER_PORT=
APP_SERVER_URL=

# 인증 API 스펙 전체가 공개된다. 로컬/스테이징에서만 true로 둘 것.
API_DOCS_ENABLED=true

DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000
JPA_DDL_AUTO=validate
JPA_BATCH_FETCH_SIZE=100
FLYWAY_ENABLED=true
LOG_LEVEL_SQL=DEBUG

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=3s

CORS_ALLOWED_ORIGINS=

JWT_SECRET=
JWT_ISSUER=
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=14d
JWT_SESSION_ABSOLUTE_TTL=90d
JWT_LOGIN_CODE_TTL=60s
JWT_COOKIE_NAME=galpi_refresh
JWT_COOKIE_PATH=/auth
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax
JWT_COOKIE_DOMAIN=

TOKEN_ENCRYPTION_CURRENT_VERSION=1
TOKEN_ENCRYPTION_KEY_V1=
TOKEN_ENCRYPTION_KEY_V2=
TOKEN_ENCRYPTION_KEY_V3=

GITHUB_APP_ID=
# App 설치 URL(github.com/apps/{slug}/installations/new)에 쓰인다.
# App 설정 페이지 주소 끝에 붙어 있는 값이다. app-id(숫자)와 다르다.
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_APP_BASE_URL=
GITHUB_API_VERSION=2022-11-28
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_OAUTH_BASE_URL=https://github.com
GITHUB_USER_AGENT=Galpi

GITHUB_ALLOWED_REDIRECT_ORIGINS=
GITHUB_DEFAULT_REDIRECT_URI=

GITHUB_CONNECT_TIMEOUT=5s
GITHUB_READ_TIMEOUT=15s
GITHUB_MAX_RETRIES=2
GITHUB_MAX_PAGES=10
# 한 사용자 작업 전체에 적용되는 GitHub API 호출·시간·동시 실행 상한.
GITHUB_OPERATION_MAX_REQUESTS=50
GITHUB_OPERATION_TIMEOUT=30s
GITHUB_OPERATION_MAX_CONCURRENT_PER_USER=1
GITHUB_OPERATION_ACQUIRE_TIMEOUT=3s

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_MAX_OUTPUT_TOKENS=128000
OPENAI_TIMEOUT=10m
OPENAI_MAX_ATTEMPTS=3
# 분석 한 건이 재시도까지 포함해 쓸 수 있는 시간. 진행 중인 호출은 끊지 않아 실제 종료는 OPENAI_TIMEOUT만큼 늦어질 수 있다.
OPENAI_ANALYSIS_BUDGET=15m

FEATURE_EXTRACTION_CORE_POOL_SIZE=3
FEATURE_EXTRACTION_MAX_POOL_SIZE=3
FEATURE_EXTRACTION_QUEUE_CAPACITY=20
FEATURE_EXTRACTION_AWAIT_TERMINATION=60s

# 사용자당 프로젝트 수 상한과 목록 페이지 크기.
PROJECT_MAX_PER_USER=50
PROJECT_DEFAULT_PAGE_SIZE=20
PROJECT_MAX_PAGE_SIZE=100

# 외부 AI 전송 고지의 현재 버전. 평소에는 설정하지 않는다 — 문구와 버전은 AiDataNotice가 한
# 몸으로 들고 있고 그 값이 기본값이다. 여기에 적어 두면 코드에서 버전을 올려도 이 값이 덮어써서
# 재동의가 걸리지 않는다. 운영에서 굳이 되돌려야 할 때만 아래 주석을 풀되, 문구가 등록되지 않은
# 버전을 주면 기동 자체가 실패한다.
#
# 이름이 낯설어 보이지만 galpi.consent.ai-data-version에 대응하는 유일한 환경변수다. 속성
# 이름을 환경변수로 옮길 때 점은 밑줄이 되고 하이픈은 사라진다 — AI_DATA_CONSENT_VERSION처럼
# 직접 지은 이름은 어디에도 매핑되지 않고 조용히 무시된다.
#GALPI_CONSENT_AIDATAVERSION=2026-08-23
